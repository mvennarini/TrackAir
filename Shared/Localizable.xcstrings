      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN sbagliato (%lld di 3)."
          }
        }
      }
    },
    "Wrong PIN. Check the number on your Mac and try again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN sbagliato. Controlla il numero sul Mac e riprova."
          }
        }
      }
