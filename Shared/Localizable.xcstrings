{
  "sourceLanguage": "en",
  "strings": {
    "%@ is now paired.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è ora abbinato."
          }
        }
      }
    },
    "A 6-digit PIN is shown on your Mac's screen. Enter it here to pair securely.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sullo schermo del Mac compare un PIN di 6 cifre. Inseriscilo qui per abbinare in modo sicuro."
          }
        }
      }
    },
