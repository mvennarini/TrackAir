      }
    },
    "Too many attempts. Wait 30 seconds and try again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi. Aspetta 30 secondi e riprova."
          }
        }
      }
    },
    "Valid for 2 minutes. Only devices on your network can see this Mac.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valido per 2 minuti. Solo i dispositivi sulla tua rete vedono questo Mac."
          }
        }
      }
    },
