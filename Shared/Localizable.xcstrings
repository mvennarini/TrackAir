    "Pointer speed: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocità puntatore: %@"
          }
        }
      }
    },
    "Scroll speed: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocità scorrimento: %@"
          }
        }
      }
    },
    "TrackAir %@. Connections are encrypted end to end (ChaCha20-Poly1305) after pairing with a PIN. No data leaves your network.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TrackAir %@. Le connessioni sono cifrate end-to-end (ChaCha20-Poly1305) dopo l'abbinamento con PIN. Nessun dato esce dalla tua rete."
          }
        }
      }
    },
    "Pairing code": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codice di abbinamento"
          }
        }
      }
    },
    "Point your iPhone or iPad camera at the code": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadra il codice con la fotocamera dell'iPhone o dell'iPad"
          }
        }
      }
    },
    "%@ wants to pair. Point its camera at the code:": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chiede di abbinarsi. Inquadra il codice con la sua fotocamera:"
          }
        }
      }
    },
    "Or type this PIN: %@ %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure digita questo PIN: %@ %@"
          }
        }
      }
    },
    "That Mac is not on this network.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel Mac non è su questa rete."
          }
        }
      }
    },
    "Code read. Pairing…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codice letto. Abbinamento…"
          }
        }
      }
    },
    "Type the PIN instead": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferisco digitare il PIN"
          }
        }
      }
    },
    "Scan the code instead": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferisco inquadrare il codice"
          }
        }
      }
    },
    "I don't see a code on the Mac": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vedo nessun codice sul Mac"
          }
        }
      }
    },
    "Point the camera at the glowing code on your Mac's screen.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadra il codice luminoso sullo schermo del Mac."
          }
        }
      }
    },
    "You can start using it right away.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi usarlo subito."
          }
        }
      }
    },
    "Keyboard": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastiera"
          }
        }
      }
    },
    "Copy web address: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia indirizzo web: %@"
          }
        }
      }
    },
    "The Mac is not answering. Check that both are on the same Wi-Fi network.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac non risponde. Controlla che siano sulla stessa rete Wi-Fi."
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova"
          }
        }
      }
    },
    "Pair again": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbina di nuovo"
          }
        }
      }
    },
    "Pinch: Apps view (close to open, spread to close)": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizzico: vista App (chiudi per aprire, allarga per chiudere)"
          }
        }
      }
    },
    "One finger moves. Tap to click, double-tap to double-click.\nTwo fingers scroll with momentum. Two-finger tap for secondary click. Pinch to zoom.\nThree fingers drag.\nFour fingers left/right switch Spaces, up opens Mission Control, pinch opens the Apps view.\nKeyboard button: type on the Mac; the bar above the keys has Cmd, Ctrl, Alt, Shift, Esc, Tab and arrows for shortcuts. A hardware keyboard works too.\nDefaults mirror the Trackpad settings of your Mac.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dito muove. Tap per cliccare, doppio tap per il doppio clic.\nDue dita scorrono con inerzia. Tap a due dita per il clic secondario. Pizzico per lo zoom.\nTre dita trascinano.\nQuattro dita a sinistra/destra cambiano Spazio, in alto aprono Mission Control, il pizzico apre la vista App.\nBottone tastiera: scrivi sul Mac; la barra sopra i tasti ha Cmd, Ctrl, Alt, Shift, Esc, Tab e frecce per le scorciatoie. Funziona anche una tastiera fisica.\nI valori iniziali replicano le impostazioni Trackpad del Mac."
          }
        }
      }
    },
    "Connected to %@ via %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegato a %@ via %@"
          }
        }
      }
    },
